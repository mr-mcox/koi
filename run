#!/usr/bin/env bash
# Operator-only entry point. Runs the CLI or API against the live data
# store (data/live/), not the disposable default (./data) that manual
# testing and agent sessions use.
#
# Agents: do not invoke this script — see AGENTS.md.
set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
export SCREEN_DATA_DIR="${SCREEN_DATA_DIR:-$REPO_ROOT/data/live}"
PORT="${SCREEN_API_PORT:-8420}"

cmd="${1:-serve}"
shift || true

case "$cmd" in
  serve)
    echo "Queue: http://localhost:${PORT}/" >&2
    exec uv run uvicorn screen.api.app:app --port "$PORT" "$@"
    ;;
  backfill-digests)
    exec uv run python -c "from screen.intake.cli import backfill_digests; backfill_digests()" "$@"
    ;;
  *)
    echo "usage: ./run [serve|backfill-digests]" >&2
    exit 1
    ;;
esac
