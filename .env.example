# Operator-owned secrets. Copy to `.env` and fill in real values.
# `.env` is gitignored; do not commit it.

# Slice 0: Tavily's extract/search API.
TAVILY_API_KEY=

# Slice 2+: BAML client configuration. `BAML_CLIENT` picks the default
# client for any LLM call (one of `fireworks`, `openai`, `anthropic`).
# The model names below are the per-slice defaults chosen for
# cost-perf balance per `docs/features/steel-thread-intake-to-assertions/slices/02-decisions.md`.
BAML_CLIENT=fireworks

# Fireworks — Llama 3.1 8B Instruct, the default at slice 2+
# ($0.20/1M tokens in/out, structured-extraction capable).
BAML_FIREWORKS_MODEL=accounts/fireworks/models/llama-v3p1-8b-instruct
FIREWORKS_API_KEY=

# OpenAI — used when `BAML_CLIENT=openai`.
BAML_OPENAI_MODEL=gpt-4.1-mini
OPENAI_API_KEY=

# Anthropic — used when `BAML_CLIENT=anthropic`.
BAML_ANTHROPIC_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_API_KEY=
